# Exclude all top-level hidden directories by convention
/.*/

# Exclude tarballs generated by `npm pack`
/*.tgz

__mocks__
__tests__

/babel.config.js
/android/src/androidTest/
/android/src/test/
/android/build/
/example/

# SwiftPM test harness for the iOS sources
/ios/Package.swift
/ios/Tests/
/ios/.build/
/ios/.swiftpm/

# Test config
/jest.config.cjs

# TypeScript build cache (a hidden file, so /.*/ above doesn't catch it)
/.tsbuildinfo
/tsconfig.json

# Repo tooling and docs for contributors and agents, not for users
/AGENTS.md
/GLOSSARY.md
/docs/
/oxlint.config.mjs
